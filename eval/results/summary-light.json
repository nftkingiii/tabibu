{
  "summary": "The same questions, guideline excerpts and verification, run once on the device through QVAC and once through a cloud model.",
  "method": "40 questions from eval/questions.json (22 guideline answers, 10 danger-sign cases, 8 out-of-scope), written by the developer before the first run.",
  "device": "Intel(R) Xeon(R) Processor @ 2.10GHz (4 threads), 16 GB RAM, linux 6.18.44-fc-v185",
  "date": "2026-10-29",
  "backends": [
    "local",
    "cloud"
  ],
  "backendLabels": {
    "local": "Tabibu on device (QVAC)",
    "cloud": "Cloud (claude-sonnet-5-5)"
  },
  "metrics": [
    {
      "key": "answers",
      "label": "Guideline answers with every expected fact",
      "values": {
        "local": "14/22",
        "cloud": "22/22"
      }
    },
    {
      "key": "pages",
      "label": "Answer cites the page that states it",
      "values": {
        "local": "14/22",
        "cloud": "18/22"
      }
    },
    {
      "key": "swahili",
      "label": "Kiswahili questions answered in Kiswahili",
      "values": {
        "local": "5/8",
        "cloud": "8/8"
      }
    },
    {
      "key": "dangerRecall",
      "label": "Danger signs that triggered urgent referral",
      "values": {
        "local": "11/11",
        "cloud": "11/11"
      }
    },
    {
      "key": "exactSigns",
      "label": "Exact danger sign named, with page",
      "values": {
        "local": "11/11",
        "cloud": null
      }
    },
    {
      "key": "falseReferrals",
      "label": "Referral raised with no danger sign",
      "values": {
        "local": "0/29",
        "cloud": "3/29"
      }
    },
    {
      "key": "refusals",
      "label": "Out-of-scope questions refused",
      "values": {
        "local": "8/8",
        "cloud": "8/8"
      }
    },
    {
      "key": "removed",
      "label": "Steps removed by verification (number not on page, or wrong age row)",
      "values": {
        "local": "5 of 74",
        "cloud": "0 of 108"
      }
    },
    {
      "key": "p50",
      "label": "Median time per question",
      "values": {
        "local": "17.7 s",
        "cloud": "3.7 s"
      }
    },
    {
      "key": "p90",
      "label": "90th percentile time",
      "values": {
        "local": "43.1 s",
        "cloud": "6.6 s"
      }
    },
    {
      "key": "kbSent",
      "label": "Data sent off the device per question",
      "values": {
        "local": "0.0 KB",
        "cloud": "4.9 KB"
      }
    },
    {
      "key": "costPer1000",
      "label": "Cost per 1,000 questions",
      "values": {
        "local": "$0.00",
        "cloud": "$6.14"
      }
    },
    {
      "key": "memory",
      "label": "Peak memory on device",
      "values": {
        "local": "5.8 GB",
        "cloud": "Not on device"
      }
    },
    {
      "key": "offline",
      "label": "Works with the internet off",
      "values": {
        "local": "Yes",
        "cloud": "No"
      }
    },
    {
      "key": "errors",
      "label": "Errors",
      "values": {
        "local": "0",
        "cloud": "0"
      }
    }
  ]
}